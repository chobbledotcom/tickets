{
  "threshold": 0,
  "noTips": true,
  "reporters": [
    "console",
    "json"
  ],
  "output": ".jscpd-report-test",
  "ignore": [
    "**/node_modules/**",
    "**/package-lock.json",
    "**/deno.lock",
    "**/test/specs/support/**"
  ],
  "format": [
    "typescript",
    "tsx"
  ],
  "absolute": false,
  "gitignore": true,
  "exitCode": 1,
  "minLines": 1,
  "minTokens": 48,
  "path": [
    "test"
  ]
}