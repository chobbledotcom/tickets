{
  "threshold": 100,
  "noTips": true,
  "reporters": [
    "console",
    "json"
  ],
  "output": ".jscpd-report-support",
  "ignore": [
    "**/node_modules/**",
    "**/*.test.ts"
  ],
  "format": [
    "typescript",
    "tsx"
  ],
  "absolute": true,
  "gitignore": true,
  "ignoreIdentifiers": true,
  "ignoreLiterals": true,
  "ignoreAnnotations": true,
  "minLines": 1,
  "minTokens": 40,
  "path": [
    "test/specs/support"
  ],
  "ignorePattern": [
    "(?m)^import\\s[^;]*;",
    "(?m)^export\\s+(type\\s+)?(\\*|\\{[^}]*\\})(\\s+as\\s+\\w+)?\\s+from\\s[^;]*;",
    "(?m)^\\s*const\\s+\\{[^}]*\\}\\s*=\\s*await\\s+import\\([^)]*\\);"
  ]
}
