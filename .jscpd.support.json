{
  "threshold": 0,
  "reporters": [
    "console",
    "json"
  ],
  "output": ".jscpd-report-support",
  "ignore": [
    "**/node_modules/**",
    "**/*.test.ts"
  ],
  "format": [
    "typescript",
    "tsx"
  ],
  "absolute": false,
  "gitignore": true,
  "exitCode": 1,
  "minLines": 1,
  "minTokens": 18,
  "path": [
    "test/specs/support"
  ]
}
