{
  "threshold": 0,
  "noTips": true,
  "reporters": [
    "console",
    "json"
  ],
  "output": ".jscpd-report-support",
  "ignore": [
    "**/node_modules/**",
    "**/*.test.ts"
  ],
  "format": [
    "typescript",
    "tsx"
  ],
  "absolute": false,
  "gitignore": true,
  "exitCode": 1,
  "ignoreIdentifiers": true,
  "ignoreLiterals": true,
  "ignoreAnnotations": true,
  "kind": [
    "exact"
  ],
  "minLines": 1,
  "minTokens": 15,
  "path": [
    "test/specs/support"
  ]
}
