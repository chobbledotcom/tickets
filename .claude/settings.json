{
  "permissions": {
    "allow": [
      "mcp__Claude_Code_Remote__send_later",
      "Bash(devenv shell deno task test)",
      "Bash(devenv shell deno task test:*)",
      "Bash(devenv shell deno task typecheck)",
      "Bash(devenv shell deno task lint)",
      "Bash(devenv shell deno task lint:ci)",
      "Bash(devenv shell deno task cpd)",
      "Bash(devenv shell deno task precommit)",
      "Bash(devenv shell deno task precommit:*)",
      "Bash(devenv shell deno task mutation)",
      "Bash(devenv shell deno task mutation:*)",
      "Bash(devenv shell deno task line-counts)",
      "Bash(devenv shell deno task find-unused-src)",
      "Bash(devenv shell -- deno task test:*)",
      "Bash(devenv shell -- deno task mutation:*)",
      "Bash(devenv shell pc)",
      "Bash(devenv shell container-build)",
      "Bash(devenv shell container-load)",
      "Bash(deno task test)",
      "Bash(deno task test:*)",
      "Bash(deno task typecheck)",
      "Bash(deno task lint)",
      "Bash(deno task lint:ci)",
      "Bash(deno task cpd)",
      "Bash(deno task precommit)",
      "Bash(deno task precommit:*)",
      "Bash(deno task mutation)",
      "Bash(deno task mutation:*)",
      "Bash(deno task line-counts)",
      "Bash(deno task find-unused-src)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch --show-current)",
      "Bash(git fetch origin:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath // empty' | { read -r f; case \"$f\" in *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.json|*.jsonc|*.css) devenv shell -- deno run -A scripts/biome.ts check --write \"$f\" ;; esac; }"
          }
        ]
      }
    ]
  }
}
