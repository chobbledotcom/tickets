{
  "threshold": 100,
  "noTips": true,
  "reporters": [
    "console",
    "json"
  ],
  "output": ".jscpd-report-specs",
  "ignore": [
    "**/node_modules/**",
    "**/fp.ts",
    "**/db/migrations/2*.ts",
    "**/db/migrations/schema/columns.ts"
  ],
  "format": [
    "typescript",
    "tsx"
  ],
  "absolute": false,
  "gitignore": true,
  "minLines": 1,
  "minTokens": 18,
  "path": [
    "src",
    "test/specs/support"
  ]
}