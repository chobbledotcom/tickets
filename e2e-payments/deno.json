{
  "name": "tickets-e2e-payments",
  "version": "0.0.0",
  "exports": "./src/main.ts",
  "description": "Browser-driven end-to-end payment tests against real provider sandboxes (Stripe/Square/SumUp). Not part of the normal test suite.",
  "tasks": {
    "e2e": "deno run -A src/main.ts"
  },
  "imports": {
    "playwright": "npm:playwright@1.61.1"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable",
      "deno.ns",
      "deno.unstable"
    ]
  }
}
