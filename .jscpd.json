{
  "threshold": 0,
  "noTips": true,
  "reporters": [
    "console",
    "json"
  ],
  "output": ".jscpd-report",
  "ignore": [
    "**/node_modules/**",
    "**/package-lock.json",
    "**/deno.lock",
    "**/fp.ts",
    "**/db/migrations/2*.ts",
    "**/db/migrations/schema/columns.ts",
    "**/cpd-renamed/allowed.json"
  ],
  "format": [
    "bash",
    "javascript",
    "json",
    "typescript",
    "tsx"
  ],
  "absolute": false,
  "gitignore": true,
  "exitCode": 1,
  "minLines": 1,
  "minTokens": 19,
  "path": [
    "src",
    "e2e-payments",
    "scripts"
  ]
}
