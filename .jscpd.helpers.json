{
  "threshold": 0,
  "reporters": [
    "console",
    "json"
  ],
  "output": ".jscpd-report-helpers",
  "ignore": [
    "**/node_modules/**",
    "**/fp.ts",
    "**/db/migrations/2*.ts",
    "**/db/migrations/schema/columns.ts",
    "**/test-utils/**/*.test.ts"
  ],
  "format": [
    "typescript",
    "tsx"
  ],
  "absolute": false,
  "gitignore": true,
  "exitCode": 1,
  "minLines": 1,
  "minTokens": 40,
  "path": [
    "src",
    "test/test-utils"
  ]
}
