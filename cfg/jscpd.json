{
  "threshold": 100,
  "noTips": true,
  "reporters": [
    "console",
    "json"
  ],
  "output": ".jscpd-report",
  "ignore": [
    "**/node_modules/**",
    "**/package-lock.json",
    "**/deno.lock",
    "**/fp.ts",
    "**/db/migrations/2*.ts",
    "**/db/migrations/schema/columns.ts",
    "**/*.generated.ts"
  ],
  "format": [
    "bash",
    "javascript",
    "typescript",
    "tsx"
  ],
  "absolute": true,
  "gitignore": true,
  "ignoreIdentifiers": true,
  "ignoreLiterals": true,
  "ignoreAnnotations": true,
  "minLines": 1,
  "minTokens": 40,
  "path": [
    "../src",
    "../e2e-payments",
    "../scripts"
  ],
  "ignorePattern": [
    "(?m)^import\\s[^;]*;",
    "(?m)^export\\s+(type\\s+)?(\\*|\\{[^}]*\\})(\\s+as\\s+\\w+)?\\s+from\\s[^;]*;"
  ]
}
