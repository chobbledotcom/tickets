{
  "threshold": 100,
  "noTips": true,
  "reporters": [
    "console",
    "json"
  ],
  "output": ".jscpd-report-test",
  "ignore": [
    "**/node_modules/**",
    "**/package-lock.json",
    "**/deno.lock",
    "**/test/specs/support/**"
  ],
  "format": [
    "typescript",
    "tsx"
  ],
  "absolute": true,
  "gitignore": true,
  "ignoreIdentifiers": true,
  "ignoreLiterals": true,
  "ignoreAnnotations": true,
  "minLines": 1,
  "minTokens": 48,
  "path": [
    "../test"
  ],
  "ignorePattern": [
    "(?m)^import\\s[^;]*;",
    "(?m)^export\\s+(type\\s+)?(\\*|\\{[^}]*\\})(\\s+as\\s+\\w+)?\\s+from\\s[^;]*;"
  ]
}
