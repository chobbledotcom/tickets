{
  "threshold": 100,
  "noTips": true,
  "reporters": [
    "console",
    "json"
  ],
  "output": ".jscpd-renamed-report",
  "ignore": [
    "**/node_modules/**",
    "**/package-lock.json",
    "**/deno.lock",
    "**/fp.ts",
    "**/db/migrations/2*.ts",
    "**/db/migrations/schema/columns.ts"
  ],
  "format": [
    "typescript",
    "tsx",
    "javascript"
  ],
  "absolute": false,
  "minLines": 1,
  "minTokens": 20,
  "similarity": 0.99,
  "path": [
    "src",
    "e2e-payments",
    "scripts"
  ]
}
